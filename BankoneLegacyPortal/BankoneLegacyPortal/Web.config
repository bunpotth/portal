<?xml version="1.0"?>
<!--
  Bankone Corporate Portal - Web Configuration
  Last modified: J.Thompson 2013-09-12
  NOTE: Do not enable customErrors in dev - see BANKLB-892
-->
<configuration>
  <connectionStrings>
    <!-- Production uses SQL Server 2008 R2 on BKDB01 - see \\fileserver\bankone\docs\db-config.txt -->
    <add name="BankoneDB"
         connectionString="Data Source=(LocalDb)\v11.0;AttachDbFilename=|DataDirectory|\BankoneLegacy.mdf;Initial Catalog=BankoneLegacy;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="BankoneVersion" value="2.3" />
    <add key="SupportEmail" value="support@bankone.com" />
    <!-- BANKLB-421: Move jQuery/Bootstrap to local files -->
    <add key="UseLocalScripts" value="false" />
  </appSettings>
  <system.web>
    <!-- debug=true left on - BANKLB-892: must be false before next prod deploy -->
    <compilation debug="true" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" maxRequestLength="4096" />
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login.aspx" timeout="30" slidingExpiration="true" cookieless="UseCookies" />
    </authentication>
    <authorization>
      <allow users="*" />
    </authorization>
    <!-- customErrors mode="Off" - stack traces visible in production (BANKLB-892) -->
    <customErrors mode="Off" />
    <sessionState mode="InProc" cookieless="false" timeout="20" />
    <pages validateRequest="false" />
  </system.web>
  <!-- Account pages open to all (login/register) -->
  <location path="Account">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- Banking pages require login -->
  <location path="Accounts">
    <system.web>
      <authorization>
        <deny users="?" />
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- Branch locator requires login -->
  <location path="Branch">
    <system.web>
      <authorization>
        <deny users="?" />
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- Admin section: Admin role only -->
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
